# ============================================================================

# liveTrade configuration — copy this file to ".env" and fill in the values.

# (Run on the Windows PC where the MT5 / Exness terminal is logged in.)

# ============================================================================



# ---- Strategy ----

# s97 = with-trend mean-reversion basket (4H).  s98 = XAUUSD trend+liquidity+ATR trail (1H).

# The command line --strategy 97|98 OVERRIDES this value.

STRATEGY_ID=s97



# ---- MetaTrader 5 / Exness ----

# Leave LOGIN/PASSWORD/SERVER blank to attach to the already-logged-in terminal.

MT5_LOGIN=

MT5_PASSWORD=

MT5_SERVER=                 # e.g. Exness-MT5Real  or  Exness-MT5Trial8

MT5_PATH=                   # optional: full path to terminal64.exe

MT5_SYMBOL_SUFFIX=          # Exness symbol suffix if any (e.g. "m"  ->  EURUSDm). Leave blank to auto-resolve.



# ---- What to trade ----

# Leave BLANK to auto-pick the strategy's default basket:

#   s97 -> EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,NZDUSD,USDCAD,XAUUSD

#   s98 -> XAUUSD

# Or set an explicit comma-separated list to override.

SYMBOLS=



# ---- Position sizing ----

# FIXED_LOT > 0 disables margin-based sizing and uses that lot on every trade.

FIXED_LOT=0.01

ACCOUNT_CCY=INR

MARGIN_PER_TRADE_INR=1000   # used only when FIXED_LOT=0

LEVERAGE=2000

MAX_LOT=50                  # hard cap on lot size per trade (safety)



# ---- Risk guards ----

DRY_RUN=true                # true = log signals only, DO NOT place real orders. Set false to go live.

ONE_TRADE_PER_PAIR=true

MAX_CONCURRENT_TRADES=8     # s97 basket: up to 8 (one per pair).  s98 gold: set 1.

MAX_DAILY_LOSS_INR=10000    # pause new trades once realised loss for the day exceeds this (0 = disabled)

# Cap SL loss before entry. Effective cap = min of enabled limits (0 = that limit disabled).
# Prefer % in the 5–20% band for fixed-lot gold; set MAX_RISK_INR=0 so % alone applies.
# The shared MAX_RISK_INR/MAX_RISK_PCT settings are not applied by s146.
# s146 deliberately allows valid signals regardless of estimated account risk;
# loss_at_sl remains informational in its logs/emails. These caps remain
# available to the other strategies that use the shared risk guard.
MAX_RISK_INR=0              # used by other strategies; ignored by s146

MAX_RISK_PCT=15.0           # used by other strategies; ignored by s146

# s98: reject entries long after the 1H signal close (avoids power-cut / late-restart fills).
# Use 60 for near-backtest fills (next open); 900 allows up to 15 min after bar close.

S98_MAX_ENTRY_DELAY_SEC=60



# ---- Engine loop ----

POLL_SECONDS=15

CANDLE_CLOSE_LAG_SEC=8



# ---- Email alerts (Gmail: use an App Password, not your login password) ----

SMTP_HOST=smtp.gmail.com

SMTP_PORT=465

SMTP_USER=

SMTP_PASS=

EMAIL_FROM=

EMAIL_TO=



# ---- Strategy 95 params (only when STRATEGY_ID=s95) ----

PARTIAL_R=0.5

FINAL_R=1.5

BIAS_TTL_HOURS=16

MIN_DISPLACEMENT_PCT=0.10

FOREX_SL_BUFFER_PIPS=15



# ---- Strategy 97 params (only when running --strategy 97; defaults match backtest) ----

S97_TREND_EMA=200

S97_SMA_N=20

S97_ATR_N=14

S97_Z_ENTRY=2.0             # pullback stretch (ATRs) to fade. 2.5 = fewer, higher-conviction trades

S97_Z_EXIT=0.5             # mean-revert take-profit distance from SMA (ATRs)

S97_K_SL=2.5               # initial ATR stop = 1R

S97_MAX_HOLD_BARS=48       # flat after 48 4H bars (~8 trading days)

S97_FETCH_BARS=1500        # 4H bars fetched so EMA200 matches the backtest (>=800 needed)



# ---- Strategy 98 params (only when STRATEGY_ID=s98; defaults match backtest) ----

S98_HTF_EMA=50

S98_RANGE_LOOKBACK=20

S98_DONCHIAN=20

S98_ATR_LEN=14

S98_ATR_MULT_INIT=1.5

S98_ATR_MULT_TRAIL=3.0

S98_ALSO_BREAKOUT=true

S98_SESSION_FILTER=false

S98_USE_PD_FILTER=true



# ---- Strategy 146 params (only when running --strategy 146) ----------------
# Entries travel TOWARD an unmitigated 4H zone. Once that destination confirms,
# the engine tracks confirmed 15m zones and only permits execution from the
# running price extreme available so far.

# Demo-only safety: refuse to send orders on a non-demo account.
S146_DEMO_ONLY=true

# Sizing for Rs 1000 of margin per trade at 1:2000
# FIXED_LOT=0            -> use margin sizing below
# MARGIN_PER_TRADE_INR=1000
# LEVERAGE=2000
# ONE_TRADE_PER_PAIR=true
#
# MAX_CONCURRENT_TRADES caps total exposure. The s146 basket in run.py is 29
# symbols, so leaving this at 8 permits Rs 8000 of margin committed at once.
# Set it to 1 if you really want a single open trade at a time.
# MAX_CONCURRENT_TRADES=8

# The 4H destination is the QUALIFIER, not the target: it must sit this far away
# in R for the signal to be taken, but the trade banks at S146_TP_R instead.
S146_TP_R=1.25              # take profit = 1.25 x risk, measured from the fill

S146_MIN_RR=1.5             # minimum reward:risk to the 4H destination
S146_MAX_RR=20.0            # reject lottery-distance targets

S146_STOP_BUFFER_BPS=0.5    # buffer beyond the 15m zone distal edge

# ---------------------------------------------------------------- exit ladder
# With the ladder ON the broker holds SL plus a TP at the 4H DESTINATION, so the
# position stays protected even if the engine dies. This process then:
#   1. banks S146_PARTIAL_FRACTION at market once price reaches S146_PARTIAL_AT_R
#      (MT5 cannot hold a partial-volume TP, so it has to be done from here),
#   2. pulls the stop to breakeven at that moment,
#   3. ratchets the stop S146_TRAIL_GIVEBACK_R behind the highest rung reached,
#      where rungs sit on a S146_TRAIL_STEP_R grid ABOVE the partial level:
#         peak 1.25R -> breakeven    peak 2.0R -> +1.5R
#         peak 1.5R  -> +1.0R        peak 2.5R -> +2.0R
# Stops never move against the position. The target deliberately does NOT chase
# price: a TP kept ahead of the highest rung could never fill, so the advancing
# stop is what ends the trade and the 4H destination is its ceiling.
# NOTE: a 0.01 lot position cannot be halved, so the partial is skipped and the
# whole position rides the trail instead (logged as `partial_skipped`).
S146_LADDER_ENABLED=true
S146_PARTIAL_AT_R=1.25      # bank the first tranche here, and move stop to BE
S146_PARTIAL_FRACTION=0.5   # fraction of volume closed at S146_PARTIAL_AT_R
S146_TRAIL_STEP_R=0.5       # rung spacing above the partial level
S146_TRAIL_GIVEBACK_R=0.5   # how far behind the highest rung the stop sits

# ---------------------------------------------------------------- money lock
# A cash floor that does not care about R. Once floating profit reaches
# TRIGGER_MULT x the margin committed to the trade, just enough volume is closed
# at market to realise SECURE_MULT x that margin; the R ladder above then keeps
# managing the remainder. With Rs 1000 of margin the defaults mean: at Rs 1500
# of open profit, bank about Rs 700.
# Notes:
#   * fires at most ONCE per position, and always leaves at least the broker
#     minimum volume running, so it can never close the trade outright;
#   * volume is rounded UP to the broker step, so the banked amount is "at
#     least" the target, not exactly it;
#   * on a position that cannot be split (0.01 lots) it is skipped and logged;
#   * margin is snapshotted at full volume, so a later partial cannot lower the
#     trigger.
S146_MONEY_LOCK_ENABLED=true
S146_MONEY_LOCK_TRIGGER_MULT=1.5
S146_MONEY_LOCK_SECURE_MULT=0.7

# ------------------------------------------------------------- stop placement
# Hide the stop behind the nearest pool of resting orders just outside the 15m
# entry zone (equal highs/lows preferred, since that is where stops cluster)
# rather than always using the zone's distal edge. Two guards keep this bounded:
#   * the zone's distal edge is the FLOOR - a pool inside the zone would put the
#     stop inside the structure the trade is built on, so it is never used;
#   * a pool further than S146_STOP_LIQ_MAX_MULT x the plain zone-distal stop is
#     rejected as "too far" and the zone edge is used instead.
# A liquidation entry also pushes the stop beyond the wick that swept the stops,
# because a stop at the zone edge would otherwise sit inside that very move.
# Wider stops lower the R to the destination, so some signals will now fail the
# S146_MIN_RR gate. That is intended.
S146_STOP_USE_LIQUIDITY=true
S146_STOP_LIQ_LOOKBACK_5M=72   # 5m bars searched for pools (~6 hours)
S146_STOP_LIQ_MAX_MULT=1.5     # max stop width vs plain zone-distal risk
# Execution availability only; does not enable MAX_RISK_INR/MAX_RISK_PCT.
S146_FREE_MARGIN_FRACTION=0.80 # leave 20% free-margin headroom
# Cost gate: skip a signal when the live spread is more than this share of the
# intended risk. A trade pays ~2 spreads round trip and a SHORT stop fires on
# ask, one spread inside the structural level, so a high ratio removes the edge
# before price moves. Cost-based, NOT a minimum stop distance in pips.
S146_MAX_SPREAD_PCT_OF_RISK=0.30

# Experimental pre-order destination-quality gate. Keep false while it shadows
# new signals. When enabled it requires the selected 4H destination to be
# compact, promptly confirmed, and cheap enough relative to requested risk.
# Any numeric limit <= 0 disables just that one check.
S146_PREORDER_DESTINATION_QUALITY_GATE=false
S146_PREORDER_MAX_DESTINATION_WIDTH_R=1.0
S146_PREORDER_MAX_DESTINATION_ORIGIN_LAG_H4_BARS=4.0
S146_PREORDER_MAX_SPREAD_PCT_OF_REQUESTED_RISK=0.15

S146_SHORT_STOP_SPREAD_PAD=0.0 # off: pads short stops by n x spread if > 0
# Count open positions and pending orders for correlation protection.
S146_MAX_SAME_DESTINATION=1
S146_MAX_CURRENCY_EXPOSURE=3

S146_MAX_WAIT_BARS_5M=864   # price must return to the 15m zone within this many 5m bars
S146_MAX_HOLD_BARS_5M=864   # hard holding limit, then close at market (~3 trading days)

# "market" takes the trade as soon as the 5m confirmation closes (default).
# "stop" instead rests a buy-stop/sell-stop past the signal candle (backtest parity).
# Resting orders are GTC and are never cancelled for staying unfilled; they are
# only withdrawn if the 4H destination gets reached before the fill.
S146_ENTRY_MODE=market

# true = SL and TP go out with the order, so the broker owns both exits.
# s146 does not apply MAX_RISK_PCT / MAX_RISK_INR as a pre-trade blocker;
# loss_at_sl is informational. false = send naked and set levels by hand.
S146_ATTACH_SL_TP=true

# Only accept a 5m execution when its confirmed 15m zone is the running price
# extreme since the selected 4H destination confirmed: highest proximal supply
# for a short, lowest proximal demand for a long. Invalidated, expired, or
# previously-confirmed/consumed zones do not block a current signal.
S146_REQUIRE_RUNNING_EXTREME_15M=true
# Rollback behavior only when the running-extreme rule above is false.
S146_REQUIRE_NEW_15M=true

# Destination (4H POI) quality filters. Set either to 0 to disable it.
#   AGE: how old the POI's origin candle may be, measured to the latest closed 5m
#        bar. Keeps the draw inside the current regime. Widening this also means
#        S146_FETCH_4H_BARS below must be raised to keep those zones visible.
#   BOS LAG: 4H bars allowed between the POI's origin candle and the break of
#        structure that confirmed it. A long gap means the two are unrelated.
S146_MAX_DEST_AGE_DAYS=7
S146_MAX_DEST_BOS_LAG_BARS=8

# History depth per fetch. This is the main driver of 5m scan time, so keep it
# only as deep as the oldest structure that is still eligible.
#   4h : 600 bars = 100 days, ample for a 7-day destination age cap.
#        RAISE THIS if you widen S146_MAX_DEST_AGE_DAYS or set it to 0.
#   15m: 1500 bars = ~15 days; covers campaigns allowed by the 7-day 4H age cap.
#   5m : 1500 bars = ~5 days, covers max_wait_bars_5m (864) with margin.
S146_FETCH_4H_BARS=600
S146_FETCH_15M_BARS=1500
S146_FETCH_5M_BARS=1500

# ===================== Strategy 147 (4H POI reaction) =====================
# S147 waits for price to ARRIVE at a 4H point of interest and trades the
# reaction away from it. This is the opposite execution to S146, which travels
# toward an unmitigated 4H zone.
#
# There is deliberately NO age limit on the 4H POI: an old untested zone is as
# valid as a fresh one. A POI dies only when a 15m bar CLOSES fully beyond its
# distal edge, and it may be traded again on later visits.

S147_REWARD_RISK=1.5          # fixed take profit in R, measured from the fill
S147_STOP_BUFFER_BPS=0.5      # stop sits this far beyond the 15m zone distal edge

# Sequence timing, in bars of the timeframe named.
S147_MAX_WAIT_BARS_15M_CHOCH=16   # arrival -> change of character
S147_MAX_WAIT_BARS_15M_ZONE=16    # change of character -> aligned 15m zone
S147_MAX_WAIT_BARS_5M=288         # 15m zone active -> 5m return and confirmation

S147_MIN_STOP_BPS=1.0             # floor on structural risk, keeps stops out of spread noise

# History depth per fetch. 4H is deep on purpose here: old POIs stay tradable.
S147_FETCH_4H_BARS=3000
S147_FETCH_15M_BARS=1500
S147_FETCH_5M_BARS=1500

S147_ENTRY_MODE=market        # confirmation closes -> enter at market
S147_ATTACH_SL_TP=false       # false = send naked and set SL/TP by hand
S147_DEMO_ONLY=true           # refuse to send orders on a non-demo account
S147_MAX_HOLD_BARS_5M=0       # 0 = no holding limit; runs until stop or target
