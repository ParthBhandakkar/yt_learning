//+------------------------------------------------------------------+
void OnStart()
{
   int plotted = 0;
   int failed  = 0;

   // Symbol suffix detection for Exness
   string suffixes[] = {"", "m", ".m", "_i", "z"};

   // ── GBPUSD (23 trades) ──
   {
      string baseSym = "GBPUSD";
      string sym = "";
      for(int s = 0; s < ArraySize(suffixes); s++)
      {
         string candidate = baseSym + suffixes[s];
         if(SymbolSelect(candidate, true))
         {
            sym = candidate;
            break;
         }
      }
      if(sym == "")
      {
         Print("SKIP GBPUSD: symbol not found");
         failed += 23;
      }
      else
      {
         long chart = OpenOrFindChart(sym);
         if(chart <= 0)
         {
            Print("SKIP GBPUSD: cannot open chart");
            failed += 23;
         }
         else
         {
            if(ClearOnly)
            {
               ClearS97Objects(chart);
               Print("Cleared GBPUSD");
            }
            else
            {
               ClearS97Objects(chart);  // clear old before redraw
               PlotTrades_GBPUSD(chart);
               ChartRedraw(chart);
               plotted += 23;
               Print("Plotted GBPUSD: 23 trades");
            }
         }
      }
   }

   // ── AUDUSD (25 trades) ──
   {
