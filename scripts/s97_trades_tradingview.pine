entry_time_arr = switch pair
    "GBPUSD" => entry_time_GBPUSD()
    "AUDUSD" => entry_time_AUDUSD()
    "EURUSD" => entry_time_EURUSD()
    "NZDUSD" => entry_time_NZDUSD()
    "USDCAD" => entry_time_USDCAD()
    "USDCHF" => entry_time_USDCHF()
    "USDJPY" => entry_time_USDJPY()
    "XAUUSD" => entry_time_XAUUSD()
    => array.new<int>()

exit_time_arr = switch pair
    "GBPUSD" => exit_time_GBPUSD()
    "AUDUSD" => exit_time_AUDUSD()
    "EURUSD" => exit_time_EURUSD()
    "NZDUSD" => exit_time_NZDUSD()
    "USDCAD" => exit_time_USDCAD()
    "USDCHF" => exit_time_USDCHF()
    "USDJPY" => exit_time_USDJPY()
    "XAUUSD" => exit_time_XAUUSD()
    => array.new<int>()

entry_price_arr = switch pair
    "GBPUSD" => entry_price_GBPUSD()
    "AUDUSD" => entry_price_AUDUSD()
    "EURUSD" => entry_price_EURUSD()
    "NZDUSD" => entry_price_NZDUSD()
    "USDCAD" => entry_price_USDCAD()
    "USDCHF" => entry_price_USDCHF()
    "USDJPY" => entry_price_USDJPY()
    "XAUUSD" => entry_price_XAUUSD()
    => array.new<float>()

exit_price_arr = switch pair
    "GBPUSD" => exit_price_GBPUSD()
    "AUDUSD" => exit_price_AUDUSD()
    "EURUSD" => exit_price_EURUSD()
    "NZDUSD" => exit_price_NZDUSD()
    "USDCAD" => exit_price_USDCAD()
    "USDCHF" => exit_price_USDCHF()
    "USDJPY" => exit_price_USDJPY()
    "XAUUSD" => exit_price_XAUUSD()
    => array.new<float>()

stop_loss_arr = switch pair
    "GBPUSD" => stop_loss_GBPUSD()
    "AUDUSD" => stop_loss_AUDUSD()
    "EURUSD" => stop_loss_EURUSD()
    "NZDUSD" => stop_loss_NZDUSD()
    "USDCAD" => stop_loss_USDCAD()
    "USDCHF" => stop_loss_USDCHF()
    "USDJPY" => stop_loss_USDJPY()
    "XAUUSD" => stop_loss_XAUUSD()
    => array.new<float>()

take_profit_arr = switch pair
    "GBPUSD" => take_profit_GBPUSD()
    "AUDUSD" => take_profit_AUDUSD()
    "EURUSD" => take_profit_EURUSD()
    "NZDUSD" => take_profit_NZDUSD()
    "USDCAD" => take_profit_USDCAD()
    "USDCHF" => take_profit_USDCHF()
    "USDJPY" => take_profit_USDJPY()
    "XAUUSD" => take_profit_XAUUSD()
    => array.new<float>()

pnl_R_arr = switch pair
    "GBPUSD" => pnl_R_GBPUSD()
    "AUDUSD" => pnl_R_AUDUSD()
    "EURUSD" => pnl_R_EURUSD()
    "NZDUSD" => pnl_R_NZDUSD()
    "USDCAD" => pnl_R_USDCAD()
    "USDCHF" => pnl_R_USDCHF()
    "USDJPY" => pnl_R_USDJPY()
    "XAUUSD" => pnl_R_XAUUSD()
    => array.new<float>()

direction_arr = switch pair
    "GBPUSD" => direction_GBPUSD()
    "AUDUSD" => direction_AUDUSD()
    "EURUSD" => direction_EURUSD()
    "NZDUSD" => direction_NZDUSD()
    "USDCAD" => direction_USDCAD()
    "USDCHF" => direction_USDCHF()
    "USDJPY" => direction_USDJPY()
    "XAUUSD" => direction_XAUUSD()
    => array.new<string>()

outcome_arr = switch pair
    "GBPUSD" => outcome_GBPUSD()
    "AUDUSD" => outcome_AUDUSD()
    "EURUSD" => outcome_EURUSD()
    "NZDUSD" => outcome_NZDUSD()
    "USDCAD" => outcome_USDCAD()
    "USDCHF" => outcome_USDCHF()
    "USDJPY" => outcome_USDJPY()
    "XAUUSD" => outcome_XAUUSD()
    => array.new<string>()

if barstate.islast
    for i = 0 to array.size(entry_time_arr) - 1
        et = array.get(entry_time_arr, i)
        ep = array.get(entry_price_arr, i)
        slp = array.get(stop_loss_arr, i)
        tpp = array.get(take_profit_arr, i)
        xp = array.get(exit_price_arr, i)
        xt = array.get(exit_time_arr, i)
        d = array.get(direction_arr, i)
        o = array.get(outcome_arr, i)
        r = array.get(pnl_R_arr, i)
        entry_bar = et
        exit_bar = xt
        if show_entry_label
            label.new(entry_bar, ep,
                 str.tostring(i+1) + " " + (d == "long" ? "▲" : "▼") + " " + str.tostring(r, "+0.000R;-0.000R"),
                 xloc = xloc.bar_time,
                 style = d == "long" ? label.style_label_up : label.style_label_down,
                 color = o == "win" ? color.green : color.red,
                 textcolor = color.white,
                 size = size.small)
        if show_sl_tp
            line.new(entry_bar, slp, exit_bar, slp,
                 xloc=xloc.bar_time, color=color.new(color.red, 40), width=1, style=line.style_dashed)
            line.new(entry_bar, tpp, exit_bar, tpp,
                 xloc=xloc.bar_time, color=color.new(color.green, 40), width=1, style=line.style_dashed)
        if show_exit
            label.new(exit_bar, xp, "✕",
                 xloc=xloc.bar_time,
                 color=color.new(color.gray, 60), textcolor=color.white, size=size.tiny)
