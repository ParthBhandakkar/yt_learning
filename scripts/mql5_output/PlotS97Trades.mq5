#define CLR_ZONE_LOSS    C'200,50,50'

input bool ClearOnly = false;  // Only clear existing objects

//+------------------------------------------------------------------+
void DrawTrendLine(long chart, string name, datetime t1, double p1,
                   datetime t2, double p2, color clr, int width=2,
                   ENUM_LINE_STYLE style=STYLE_SOLID, bool back=true)
{
   ObjectDelete(chart, name);
   ObjectCreate(chart, name, OBJ_TREND, 0, t1, p1, t2, p2);
   ObjectSetInteger(chart, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(chart, name, OBJPROP_WIDTH, width);
   ObjectSetInteger(chart, name, OBJPROP_STYLE, style);
   ObjectSetInteger(chart, name, OBJPROP_RAY_RIGHT, false);
   ObjectSetInteger(chart, name, OBJPROP_RAY_LEFT, false);
   ObjectSetInteger(chart, name, OBJPROP_BACK, back);
   ObjectSetInteger(chart, name, OBJPROP_SELECTABLE, false);
}

//+------------------------------------------------------------------+
void DrawArrow(long chart, string name, datetime t, double price,
               color clr, int code=233, int sz=2)
{
   ObjectDelete(chart, name);
   ObjectCreate(chart, name, OBJ_ARROW, 0, t, price);
   ObjectSetInteger(chart, name, OBJPROP_ARROWCODE, code);
   ObjectSetInteger(chart, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(chart, name, OBJPROP_WIDTH, sz);
   ObjectSetInteger(chart, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(chart, name, OBJPROP_BACK, false);
}

//+------------------------------------------------------------------+
void DrawRect(long chart, string name, datetime t1, double p1,
              datetime t2, double p2, color clr, bool fill=true)
{
   ObjectDelete(chart, name);
   ObjectCreate(chart, name, OBJ_RECTANGLE, 0, t1, p1, t2, p2);
   ObjectSetInteger(chart, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(chart, name, OBJPROP_FILL, fill);
   ObjectSetInteger(chart, name, OBJPROP_BACK, true);
   ObjectSetInteger(chart, name, OBJPROP_SELECTABLE, false);
}

//+------------------------------------------------------------------+
void DrawText(long chart, string name, datetime t, double price,
              string text, color clr, int fontSize=8)
{
   ObjectDelete(chart, name);
   ObjectCreate(chart, name, OBJ_TEXT, 0, t, price);
   ObjectSetString(chart, name, OBJPROP_TEXT, text);
   ObjectSetInteger(chart, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(chart, name, OBJPROP_FONTSIZE, fontSize);
   ObjectSetString(chart, name, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(chart, name, OBJPROP_SELECTABLE, false);
}

//+------------------------------------------------------------------+
void ClearS97Objects(long chart)
{
   int total = ObjectsTotal(chart, 0, -1);
   for(int i = total - 1; i >= 0; i--)
   {
      string name = ObjectName(chart, i);
      if(StringFind(name, "S97_") == 0)
         ObjectDelete(chart, name);
   }
}

//+------------------------------------------------------------------+
long OpenOrFindChart(string symbol)
{
   // Try to find existing chart
   long chart = ChartFirst();
   while(chart >= 0)
   {
      if(ChartSymbol(chart) == symbol)
      {
         ChartSetSymbolPeriod(chart, symbol, PERIOD_H4);
         return chart;
      }
      chart = ChartNext(chart);
   }
   // Open new chart
   chart = ChartOpen(symbol, PERIOD_H4);
   if(chart > 0) Sleep(500);
   return chart;
}

