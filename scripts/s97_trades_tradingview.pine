//@version=5
indicator("Strategy 97 - All Trades", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

pair = input.symbol("EURUSD", "Pair")
show_sl_tp = input.bool(true, "Show SL / TP lines")
show_exit = input.bool(true, "Show exit markers")
show_entry_label = input.bool(true, "Show entry labels")

// --- parsers: data is stored as comma-separated strings (1 token each) to stay under the compiled-token limit ---
f_ints(string s) =>
    parts = str.split(s, ",")
    res = array.new<int>()
    for prt in parts
        res.push(int(str.tonumber(prt)))
    res

f_floats(string s) =>
    parts = str.split(s, ",")
    res = array.new<float>()
    for prt in parts
        res.push(str.tonumber(prt))
    res

f_strs(string s) => str.split(s, ",")

