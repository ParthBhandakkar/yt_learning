# ============================================================================

# liveTrade configuration — copy this file to ".env" and fill in the values.

# (Run on the Windows PC where the MT5 / Exness terminal is logged in.)

# ============================================================================



# ---- Strategy ----

# s95 = legacy multi-TF MSS/OB (forex basket).  s98 = XAUUSD trend+liquidity+ATR trail (gold live).

STRATEGY_ID=s98



# ---- MetaTrader 5 / Exness ----

# Leave LOGIN/PASSWORD/SERVER blank to attach to the already-logged-in terminal.

MT5_LOGIN=

MT5_PASSWORD=

MT5_SERVER=                 # e.g. Exness-MT5Real  or  Exness-MT5Trial8

MT5_PATH=                   # optional: full path to terminal64.exe

MT5_SYMBOL_SUFFIX=          # Exness symbol suffix if any (e.g. "m"  ->  EURUSDm). Leave blank to auto-resolve.



# ---- What to trade ----

# s98 gold live: XAUUSD only.  s95 basket: comma-separated FX pairs.

SYMBOLS=XAUUSD



# ---- Position sizing ----

# FIXED_LOT > 0 disables margin-based sizing and uses that lot on every trade.

FIXED_LOT=0.01

ACCOUNT_CCY=INR

MARGIN_PER_TRADE_INR=1000   # used only when FIXED_LOT=0

LEVERAGE=2000

MAX_LOT=50                  # hard cap on lot size per trade (safety)



# ---- Risk guards ----

DRY_RUN=true                # true = log signals only, DO NOT place real orders. Set false to go live.

ONE_TRADE_PER_PAIR=true

MAX_CONCURRENT_TRADES=1     # s98: one gold position

MAX_DAILY_LOSS_INR=10000    # pause new trades once realised loss for the day exceeds this (0 = disabled)

MAX_RISK_INR=500            # skip entry if 0.01-lot SL loss would exceed this (0 = disabled)

MAX_RISK_PCT=2.0            # skip entry if SL loss would exceed this % of balance (0 = disabled)

# s98: reject entries long after the 1H signal close (backtest fills at next 1H open ~0-60s)

S98_MAX_ENTRY_DELAY_SEC=900



# ---- Engine loop ----

POLL_SECONDS=15

CANDLE_CLOSE_LAG_SEC=8



# ---- Email alerts (Gmail: use an App Password, not your login password) ----

SMTP_HOST=smtp.gmail.com

SMTP_PORT=465

SMTP_USER=

SMTP_PASS=

EMAIL_FROM=

EMAIL_TO=



# ---- Strategy 95 params (only when STRATEGY_ID=s95) ----

PARTIAL_R=0.5

FINAL_R=1.5

BIAS_TTL_HOURS=16

MIN_DISPLACEMENT_PCT=0.10

FOREX_SL_BUFFER_PIPS=15



# ---- Strategy 98 params (only when STRATEGY_ID=s98; defaults match backtest) ----

S98_HTF_EMA=50

S98_RANGE_LOOKBACK=20

S98_DONCHIAN=20

S98_ATR_LEN=14

S98_ATR_MULT_INIT=1.5

S98_ATR_MULT_TRAIL=3.0

S98_ALSO_BREAKOUT=true

S98_SESSION_FILTER=false

S98_USE_PD_FILTER=true

